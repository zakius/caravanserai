<?xml version="1.0" encoding="utf-8"?>
<!-- The Subsonic app: Google Play updates it, so it doesn't update itself (Flavor.kt), and it never had the old
     dictionary app: it installs no apps at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <queries tools:node="remove" />
</manifest>
