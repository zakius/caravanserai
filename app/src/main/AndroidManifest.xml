<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- dragoman's own updates (Update.kt); the Subsonic app has none. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: The app updating itself, once it installed itself, without asking each time -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The dictionary app of roma ytm 0.1.57 and earlier, which dragoman says can go (Flavor.kt). -->
    <queries>
        <package android:name="${dictPackage}" />
    </queries>

    <application
        android:name=".App"
        android:appComponentFactory="com.zakius.caravanserai.StartupFactory"
        tools:replace="android:appComponentFactory"
        tools:targetApi="28"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="${appLabel}"
        android:icon="@mipmap/app_icon"
        android:theme="@style/Roma"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Last.fm sends the browser back here after the user grants access. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${linkScheme}" android:host="lastfm" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <!-- The system's media controls bind this to offer "resume" after a restart. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Nothing in the app needs androidx.startup before the first frame (emoji2's font lookup, ProcessLifecycle,
             ProfileInstaller); removing the provider avoids a ContentProvider + PackageManager IPC before App.onCreate. -->
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" tools:node="remove" />
        <!-- A headset's or car's Play button when the app isn't running: it starts the service, which resumes. -->
        <receiver android:name=".MediaButtons" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
